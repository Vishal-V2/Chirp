# Fill these from Supabase → Project Settings → Database / API.
# Runtime (transaction pooler, port 6543):
DATABASE_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Migrations (session pooler / direct, port 5432):
DIRECT_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres"

NEXT_PUBLIC_SUPABASE_URL="https://PROJECT_REF.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."

# Server-only. Lets the daily clean-up job delete deactivated accounts' logins and photos.
# Supabase → Project Settings → API Keys → Secret keys. Never expose this to the browser.
SUPABASE_SECRET_KEY="sb_secret_..."
# Any long random string. Vercel sends it to the clean-up job so nobody else can trigger it.
CRON_SECRET="a-long-random-string"
