generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

generator pothos {
  provider     = "prisma-pothos-types"
  output       = "../src/generated/pothos-types.ts"
  clientOutput = "./prisma"
}

datasource db {
  provider = "postgresql"
}

/// App profile. `id` equals the Supabase Auth user id (auth.users.id).
model User {
  id                  String    @id @db.Uuid
  username            String    @unique @db.VarChar(15)
  displayName         String    @db.VarChar(50)
  bio                 String?   @db.VarChar(160)
  avatarUrl           String?
  bannerUrl           String?
  /// Notifications newer than this are unread.
  notificationsReadAt DateTime?
  /// Set when the person deactivates their account: they're hidden from
  /// everyone, and the account is deleted for good 5 days later unless they
  /// log in and reactivate it.
  deactivatedAt       DateTime?
  /// The chirp shown at the top of this user's profile (cleared if deleted).
  pinnedTweetId       String?   @unique
  pinnedTweet         Tweet?    @relation("pinned", fields: [pinnedTweetId], references: [id], onDelete: SetNull)
  /// Who may start a chat with this user (Settings → Privacy and safety).
  dmPolicy            DmPolicy  @default(EVERYONE)
  /// Read receipts: others see when you've read their messages (and you see theirs).
  readReceipts        Boolean   @default(true)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  tweets    Tweet[]
  likes     Like[]
  retweets  Retweet[]
  followers Follow[]  @relation("following")
  following Follow[]  @relation("follower")

  conversations ConversationParticipant[]
  messages      Message[]
  pollVotes     PollVote[]

  bookmarks             Bookmark[]
  hiddenMessages        HiddenMessage[]
  notificationsReceived Notification[]  @relation("notificationsReceived")
  notificationsSent     Notification[]  @relation("notificationsSent")

  /// People this user blocked / who blocked this user.
  blocks    Block[] @relation("blocker")
  blockedBy Block[] @relation("blocked")
  /// People this user muted / who muted this user.
  mutes     Mute[]  @relation("muter")
  mutedBy   Mute[]  @relation("muted")

  @@index([deactivatedAt])
}

model Tweet {
  id        String   @id @default(cuid())
  content   String   @db.VarChar(280)
  /// Uploaded images and GIFs (our storage), up to 4.
  mediaUrls String[]
  /// A place name like "Pune, India". Coordinates are never stored.
  location  String?  @db.VarChar(60)
  /// Lower-cased #tags in the text (without "#"), for hashtag pages and trends.
  hashtags  String[] @default([])
  createdAt DateTime @default(now())

  authorId String @db.Uuid
  author   User   @relation(fields: [authorId], references: [id], onDelete: Cascade)

  parentId String?
  parent   Tweet?  @relation("replies", fields: [parentId], references: [id], onDelete: Cascade)
  replies  Tweet[] @relation("replies")

  /// Set on a quote repost: the chirp being quoted. If that chirp is deleted
  /// the quote stays and shows "This chirp is unavailable".
  quotedId String?
  quoted   Tweet?  @relation("quotes", fields: [quotedId], references: [id], onDelete: SetNull)
  /// True for quote reposts, even after the quoted chirp is deleted.
  isQuote  Boolean @default(false)
  quotes   Tweet[] @relation("quotes")

  likes    Like[]
  retweets Retweet[]
  poll     Poll?

  notifications Notification[]
  bookmarks     Bookmark[]
  /// The author, if they pinned this chirp to their profile.
  pinnedBy      User?          @relation("pinned")

  @@index([authorId, createdAt(sort: Desc)])
  @@index([hashtags], type: Gin)
  @@index([quotedId])
  @@index([parentId, createdAt])
  @@index([createdAt(sort: Desc)])
}

model Like {
  userId    String   @db.Uuid
  tweetId   String
  createdAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  tweet Tweet @relation(fields: [tweetId], references: [id], onDelete: Cascade)

  @@id([userId, tweetId])
  @@index([userId, createdAt(sort: Desc)])
  @@index([tweetId])
}

model Retweet {
  userId    String   @db.Uuid
  tweetId   String
  createdAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  tweet Tweet @relation(fields: [tweetId], references: [id], onDelete: Cascade)

  @@id([userId, tweetId])
  @@index([tweetId])
}

model Follow {
  followerId  String   @db.Uuid
  followingId String   @db.Uuid
  createdAt   DateTime @default(now())

  follower  User @relation("follower", fields: [followerId], references: [id], onDelete: Cascade)
  following User @relation("following", fields: [followingId], references: [id], onDelete: Cascade)

  @@id([followerId, followingId])
  @@index([followingId])
}

/// A one-to-one direct message thread.
model Conversation {
  id          String   @id @default(cuid())
  /// 1-on-1 chats: "<smaller user id>:<larger user id>", so each pair has at
  /// most one conversation. Null for group chats.
  pairKey     String?  @unique
  /// Group chat (up to 20 people) rather than a 1-on-1.
  isGroup     Boolean  @default(false)
  /// Group name (optional; otherwise members' names are shown).
  name        String?  @db.VarChar(50)
  /// Group photo: a path in the private message-media bucket.
  photoPath   String?
  /// Who created the group (they're always an admin).
  createdById String?  @db.Uuid
  createdAt   DateTime @default(now())
  /// Bumped on every message; sorts the conversation list.
  updatedAt   DateTime @default(now())

  participants ConversationParticipant[]
  messages     Message[]

  @@index([updatedAt(sort: Desc)])
}

model ConversationParticipant {
  conversationId  String
  userId          String          @db.Uuid
  /// Messages after this are unread for this participant.
  lastReadAt      DateTime?
  /// When this participant accepted the chat. Null = it's a message request
  /// for them (someone they don't follow wrote first).
  acceptedAt      DateTime?
  /// They deleted the request: it's hidden from their inbox and requests.
  requestHiddenAt DateTime?
  /// Group admins can add/remove people, make admins, rename and change the photo.
  role            ParticipantRole @default(MEMBER)

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([conversationId, userId])
  @@index([userId])
}

model Message {
  id             String    @id @default(cuid())
  content        String    @db.VarChar(1000)
  /// Private images: paths in the "message-media" bucket, as
  /// "<conversationId>/<senderId>/<file>". Only the chat's participants can open them.
  mediaPaths     String[]  @default([])
  /// Set when the sender unsends it: its text and images are cleared and both
  /// people see "This message was deleted".
  deletedAt      DateTime?
  /// A group event shown as a small centred note ("Ada added Sam") instead
  /// of a bubble. The sender is the person who did it.
  systemText     String?   @db.VarChar(200)
  createdAt      DateTime  @default(now())
  conversationId String
  senderId       String    @db.Uuid

  conversation Conversation    @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User            @relation(fields: [senderId], references: [id], onDelete: Cascade)
  /// People who chose "Delete for you" on this message.
  hiddenFor    HiddenMessage[]

  @@index([conversationId, createdAt(sort: Desc)])
}

/// A poll attached to a chirp (2-4 options, closes at endsAt).
model Poll {
  id      String   @id @default(cuid())
  tweetId String   @unique
  endsAt  DateTime

  tweet   Tweet        @relation(fields: [tweetId], references: [id], onDelete: Cascade)
  options PollOption[]
  votes   PollVote[]
}

model PollOption {
  id       String @id @default(cuid())
  pollId   String
  text     String @db.VarChar(25)
  position Int

  poll  Poll       @relation(fields: [pollId], references: [id], onDelete: Cascade)
  votes PollVote[]

  @@index([pollId])
}

/// One vote per person per poll.
model PollVote {
  pollId    String
  optionId  String
  userId    String   @db.Uuid
  createdAt DateTime @default(now())

  poll   Poll       @relation(fields: [pollId], references: [id], onDelete: Cascade)
  option PollOption @relation(fields: [optionId], references: [id], onDelete: Cascade)
  user   User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([pollId, userId])
  @@index([optionId])
}

enum NotificationType {
  LIKE
  REPOST
  REPLY
  FOLLOW
  MENTION
  QUOTE
}

/// "actor did something to recipient's chirp / to recipient".
model Notification {
  id          String           @id @default(cuid())
  type        NotificationType
  recipientId String           @db.Uuid
  actorId     String           @db.Uuid
  /// The chirp liked/reposted, the reply, or the chirp you were mentioned in. Null for follows.
  tweetId     String?
  /// Stops duplicates for likes/reposts/follows ("LIKE:<actor>:<chirp>"); null for replies.
  dedupeKey   String?          @unique
  createdAt   DateTime         @default(now())

  recipient User   @relation("notificationsReceived", fields: [recipientId], references: [id], onDelete: Cascade)
  actor     User   @relation("notificationsSent", fields: [actorId], references: [id], onDelete: Cascade)
  tweet     Tweet? @relation(fields: [tweetId], references: [id], onDelete: Cascade)

  @@index([recipientId, createdAt(sort: Desc)])
}

/// A chirp you saved for later. Private to you.
model Bookmark {
  userId    String   @db.Uuid
  tweetId   String
  createdAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  tweet Tweet @relation(fields: [tweetId], references: [id], onDelete: Cascade)

  @@id([userId, tweetId])
  @@index([userId, createdAt(sort: Desc)])
  @@index([tweetId])
}

/// "blocker blocked blocked": neither can reply to, quote, like, repost,
/// follow, mention-notify or message the other, and their chirps are hidden.
model Block {
  blockerId String   @db.Uuid
  blockedId String   @db.Uuid
  createdAt DateTime @default(now())

  blocker User @relation("blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked User @relation("blocked", fields: [blockedId], references: [id], onDelete: Cascade)

  @@id([blockerId, blockedId])
  @@index([blockedId])
}

/// "muter muted muted": the muter stops seeing their chirps and notifications.
/// The muted person can't tell.
model Mute {
  muterId   String   @db.Uuid
  mutedId   String   @db.Uuid
  createdAt DateTime @default(now())

  muter User @relation("muter", fields: [muterId], references: [id], onDelete: Cascade)
  muted User @relation("muted", fields: [mutedId], references: [id], onDelete: Cascade)

  @@id([muterId, mutedId])
  @@index([mutedId])
}

/// "Delete for you": this message is hidden for this user only.
model HiddenMessage {
  userId    String   @db.Uuid
  messageId String
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@id([userId, messageId])
  @@index([messageId])
}

/// Who may start a chat with someone.
enum DmPolicy {
  /// Anyone; people they don't follow land in Message requests.
  EVERYONE
  /// Only people they follow.
  FOLLOWING
  /// Nobody new (chats they already accepted keep working).
  NOBODY
}

/// A person's role in a group chat.
enum ParticipantRole {
  MEMBER
  ADMIN
}
